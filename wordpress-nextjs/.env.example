# WordPress REST API Configuration
NEXT_PUBLIC_WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json
WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json

# Optional: WordPress Authentication (if needed for private content)
WORDPRESS_AUTH_USERNAME=
WORDPRESS_AUTH_PASSWORD=

# WordPress Preview Secret (copy from WordPress plugin settings)
# Go to WordPress Admin → Settings → Headless Preview to get this value
WORDPRESS_PREVIEW_SECRET=your-preview-secret-from-wordpress

# WordPress lead API Bearer token (server-only — must match LEAD_API_SECRET in WordPress)
LEAD_API_SECRET=

# Dealer Solutions inventory (MostRecentFile JSON, HTTP Basic Auth)
DEALER_SOLUTIONS_INVENTORY_URL=
DEALER_SOLUTIONS_USER=
DEALER_SOLUTIONS_PASSWORD=

# Public site URL (canonical / Open Graph / share links). Use https on live domains — if this
# is http, absolute canonical URLs can be http while users browse over https.
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Sitemap child path: /sitemap/{NEXT_PUBLIC_SITEMAP_SEGMENT}/blog-detail.xml,
# pages.xml, vehicle-listing.xml, inventory-make.xml,
# inventory-make-model.xml.
# Omit to use default `carsalesbrisbane`.
# NEXT_PUBLIC_SITEMAP_SEGMENT=carsalesbrisbane

# Dealer contact (vehicle detail CTAs)
NEXT_PUBLIC_DEALER_PHONE=07 3128 7333
NEXT_PUBLIC_DEALER_EMAIL=sales@example.com

# OpenAI (server-only — used by POST /api/openai/chat). Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google reCAPTCHA (site key is public, secret key is server-only)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
